{
  "name": "cloud-gaming-dashboard",
  "version": "1.0.0",
  "description": "Premium cloud gaming status dashboard and launcher widget for WordPress and static sites",
  "main": "assets/js/cloud-gaming-dashboard.js",
  "style": "assets/css/cloud-gaming-dashboard.css",
  "keywords": [
    "cloud-gaming",
    "status-dashboard",
    "wordpress-plugin",
    "geforce-now",
    "xbox-cloud-gaming",
    "boosteroid",
    "shadow",
    "gaming-monitor",
    "service-status",
    "launcher-widget"
  ],
  "author": {
    "name": "CloudLoadout",
    "email": "support@cloudloadout.com",
    "url": "https://cloudloadout.com"
  },
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudloadout/cloud-gaming-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/cloudloadout/cloud-gaming-dashboard/issues",
    "email": "support@cloudloadout.com"
  },
  "homepage": "https://cloudloadout.com",
  "scripts": {
    "dev": "python -m http.server 8000",
    "test": "echo \"Tests coming soon\" && exit 0",
    "lint:js": "eslint assets/js/**/*.js",
    "lint:css": "stylelint assets/css/**/*.css",
    "format": "prettier --write \"**/*.{js,css,html,md}\"",
    "build": "npm run minify:css && npm run minify:js",
    "minify:css": "cleancss -o assets/css/cloud-gaming-dashboard.min.css assets/css/cloud-gaming-dashboard.css",
    "minify:js": "uglifyjs assets/js/cloud-gaming-dashboard.js -o assets/js/cloud-gaming-dashboard.min.js -c -m",
    "watch": "npm-run-all --parallel watch:*",
    "watch:css": "onchange 'assets/css/**/*.css' -- npm run minify:css",
    "watch:js": "onchange 'assets/js/**/*.js' -- npm run minify:js"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.2",
    "eslint": "^8.50.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "prettier": "^3.0.3",
    "stylelint": "^15.10.3",
    "uglify-js": "^3.17.4"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "files": [
    "assets/",
    "templates/",
    "cloud-gaming-dashboard.php",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "directories": {
    "doc": "docs"
  }
}
