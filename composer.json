{
  "name": "cloud-gaming/availability",
  "description": "A fully responsive WordPress plugin for displaying game availability across cloud gaming platforms",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Cloud Gaming",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.9",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "classmap": [
      "includes/",
      "admin/",
      "frontend/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=WordPress .",
    "lint:fix": "phpcbf --standard=WordPress ."
  }
}
